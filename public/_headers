# Promoted images (scripts/promote.js) have no file extension, so they'd go out without a Content-Type. Browsers detect
# JPEG, PNG, GIF and WebP from the bytes whatever type is declared, so promote.js promotes only those.
/direct-img.link/*
  Content-Type: image/jpeg
  Cache-Control: public, max-age=604800
  Access-Control-Allow-Origin: *
/free.direct-img.link/*
  Content-Type: image/jpeg
  Cache-Control: public, max-age=604800
  Access-Control-Allow-Origin: *
/ai.direct-img.link/*
  Content-Type: image/jpeg
  Cache-Control: public, max-age=604800
  Access-Control-Allow-Origin: *
